   generator client {
     provider = "prisma-client"
     output   = "../app/generated/prisma"
   }

   datasource db {
     provider = "postgresql"
   }

   model Project {
     id          Int      @id @default(autoincrement())
     slug        String   @unique
     title       String
     description String
     tags        String[]
     imageUrl    String?
     link        String?
     github      String?
     createdAt   DateTime @default(now())
     updatedAt   DateTime @updatedAt
   }